unalias fetch 2>/dev/null
unalias fastfetch 2>/dev/null

fetch() {
    # 1. Выбираем случайную гифку из ~/fetch
    local RANDOM_GIF=$(find "$HOME/fetch" -maxdepth 1 -iname "*.gif" | shuf -n 1)

    # 2. Если гифка найдена, обновляем ссылку current.gif
    if [ -n "$RANDOM_GIF" ]; then
        ln -sf "$RANDOM_GIF" "$HOME/.config/fastfetch/current.gif"
    fi

    # 3. Запускаем кастомный fastfetch с флагом анимации,
    # но используем твой config.jsonc для всех остальных настроек!
    $HOME/fastfetch-gif-support/build/fastfetch \
        --config "$HOME/.config/fastfetch/config.jsonc" \
        --logo-animate \
        2>/dev/null
}

alias fastfetch="fetch"
eval "$(zoxide init zsh)"
