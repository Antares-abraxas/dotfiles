alias ff="fzf --style full --preview 'fzf-preview.sh {}' --bind 'focus:transform-header:file --brief {}'"

# Настройка цветов fzf под твою тему Catppuccin (опционально, но красиво)
export FZF_DEFAULT_OPTS="--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"

alias ls='eza --icons --color=always --group-directories-first'

# Краткий список (без скрытых файлов)
alias l='eza -F --icons'

# Длинный список (права, размер, владелец + Git статус)
alias ll='eza --all --header --long --icons --git'

# Сортировка по времени изменения (сверху самые свежие)
alias llm='eza --all --header --long --icons --sort=modified'

# Максимально подробная информация (включая inode, блоки и т.д.)
alias la='eza -lbhHigUmuSa --icons'

# Дерево папок (замена стандартному tree)
alias lt='eza --tree --icons'
alias tree='eza --tree --icons'
export TERMINAL="kitty"

